{
  "manifest_version": 3,
  "name": "Semantic Memory",
  "description": "Local-first browsing memory with GPT-5 digests.",
  "version": "0.1.0",
  "action": {
    "default_title": "Semantic Memory",
    "default_popup": "src/ui/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "bookmarks",
    "downloads",
    "downloads.open",
    "readingList",
    "sessions",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "src/ui/options/index.html",
  "commands": {
    "semantic-memory.close-tabs-to-right": {
      "description": "Mark when the user closes tabs to the right",
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      }
    },
    "semantic-memory.close-other-tabs": {
      "description": "Mark when the user closes other tabs",
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}
